DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Token internal untuk API baca; buat dengan secrets.token_urlsafe(32).
API_READ_TOKEN=
API_OPERATOR_TOKEN=

# Opsional: jadwal refresh otomatis dalam zona waktu di bawah, contoh 08:00,16:00.
# Kosongkan jika refresh hanya dimulai manual oleh operator.
REFRESH_TIMES=
REFRESH_TIMEZONE=Asia/Jakarta
REFRESH_SCHEDULE_NAME=daily-market-report
REFRESH_CATCHUP_MINUTES=10

# Batas usia data untuk USD/IDR, IHSG, dan SBN 10Y sebelum laporan ditolak.
DAILY_MARKET_CORE_MAX_AGE_DAYS=7

# Folder persisten yang sama harus dapat diakses API dan worker.
REPORT_ARTIFACT_DIR=runtime/reports

# ── LLM Narrative Engine ────────────────────────────────────────────────
# Fitur dinonaktifkan secara default. Aplikasi tetap berjalan normal tanpa
# kredensial apa pun: Dashboard, Equity Snapshot, dan PDF memakai narasi
# deterministik yang sudah ada (lihat docs/llm_rules.md).
LLM_NARRATIVE_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://opus.abhibots.com
# API key & model boleh dikosongkan selama pengembangan.
LLM_MODEL=
LLM_API_KEY=
# Opsional: menimpa jalur chat dan batas waktu.
LLM_CHAT_PATH=
LLM_TIMEOUT_SECONDS=45
LLM_JSON_MODE=true

# Sumber bukti: seeded (registry sumber di backend/config/llm_sources.json), none.
SEARCH_PROVIDER=seeded
SEARCH_API_KEY=
SEARCH_SEED_MAX_ARTICLES_PER_SOURCE=4

# Opsional: lokasi file policy dan folder kerja narasi.
LLM_RULES_FILE=
NARRATIVE_DIR=runtime/narrative


