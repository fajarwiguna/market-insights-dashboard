# ==============================================================================
# PYTHON & ENVIRONMENT
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/
.env
.env/
.env.*
!.env.example

# ==============================================================================
# LEGACY STREAMLIT & MIGRATION ARTIFACTS
# ==============================================================================
# Mengabaikan entry point Streamlit lama di root
/src/app.py
/requirements.txt

# Mengabaikan seluruh folder arsip kode lama dan dokumentasi transisi
/legacy/
/project_migration.md

# Streamlit secrets (jika masih tersisa)
.streamlit/secrets.toml

# ==============================================================================
# RUNTIME, CACHE, & LOCAL OUTPUTS
# ==============================================================================
# Mengabaikan seluruh folder runtime lokal (data, reports, charts)
/runtime/

# Local visual check output
/_cek_*.png
/_cek.pdf

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

