  "rules": {
    "note": "Halaman kanal dipakai untuk menemukan tautan artikel; yang masuk bukti adalah artikelnya, bukan halaman indeks. Sumber dengan \"format\": \"rss\" dibaca langsung dari item feed (tanpa memuat tiap artikel), dipakai saat kanal HTML diblokir. Sumber dengan \"mode\": \"query\" diekspansi dari kueri sinyal pasar sesi ini (url_template memakai placeholder {query}); tier mengikuti domain penerbit pada <source url=...>, sehingga agregator seperti news.google.com tidak dianggap sumber. Angka dari halaman registry tidak pernah menjadi angka pasar.",
    "max_articles_per_source": 4,
    "fetch_timeout_seconds": 20,
    "max_bytes_per_page": 2000000,
    "allowed_url_schemes": ["http", "https"],
    "deny_host_patterns": ["localhost", "127.0.0.1", "0.0.0.0", "169.254.169.254", "::1", "10.", "192.168.", "172.16."]
